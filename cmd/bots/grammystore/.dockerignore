# Only dependency manifests and runtime source belong in this image context.
*
!package.json
!package-lock.json
!src/
!src/**
!db/migrate.js
!db/migrations
!db/migrations/**
# Keep accidental credentials/runtime files out even when placed under src/.
**/.env
**/.env.*
**/node_modules
**/*.log
**/*.db
**/*.sqlite*
