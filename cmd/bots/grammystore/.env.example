# ==========================================
# Telegram Bot Configuration (required)
# ==========================================
BOT_TOKEN=
OWNER_IDS=
BOT_PUBLIC_USERNAME=
PRODUCT_NAME=Telesrv

# ==========================================
# gramsrv Admin API (required)
# ==========================================
GRAMSRV_API=http://gramsrv:2399
GRAMSRV_TOKEN=
GRAMSRV_ACTOR=grammystore
PUBLIC_BASE_URL=

# ==========================================
# Database Configuration (required)
# POSTGRES_* are used by docker-compose to create the database.
# DATABASE_URL is assembled automatically in docker-compose.yml.
# Do NOT set DATABASE_URL in this file for Docker deployments.
# ==========================================
POSTGRES_USER=grammystore
POSTGRES_PASSWORD=
POSTGRES_DB=grammystore

# ==========================================
# Bot Mode (required)
# "random" = generate random numbers for users
# "real"   = users must bind their real Telegram phone number
# ==========================================
BOT_MODE=random

# ==========================================
# HTTP Server
# ==========================================
CODE_HTTP_HOST=0.0.0.0
CODE_HTTP_PORT=2800
CODE_WEBHOOK_SECRET=

# ==========================================
# Optional: Required Channel Gate
# ==========================================
REQUIRED_CHANNEL=
REQUIRED_CHANNEL_URL=

# ==========================================
# Optional: Defaults
# ==========================================
DEFAULT_LANGUAGE=ru
DEFAULT_NUMBER_COUNTRY=RU
REFERRAL_BONUS=100
DAILY_BONUS=15
NOTIFICATION_TTL_DAYS=30
